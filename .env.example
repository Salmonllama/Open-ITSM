# Copy to .env and replace every change-me value. install.sh fills these in for you.

# Image tag to run. Pin a released version; upgrade by changing it and running
# docker compose pull && docker compose up -d
OPEN_ITSM_VERSION=0.1.0

# Hostname users open in the browser. A public name gets a Let's Encrypt
# certificate automatically; for an internal-only name see CADDY_GLOBAL_OPTIONS.
# A name only, no https:// or port. Links in Slack and Teams messages use it too.
APP_HOSTNAME=itsm.example.com

# Extra Caddy global options. Set to local_certs to use Caddy's internal CA
# (for hostnames that are not reachable from the internet).
CADDY_GLOBAL_OPTIONS=

# Database password. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Encrypts stored credentials (AES-256-GCM). 32 random bytes as base64.
# Generate with: openssl rand -base64 32
# Keep a copy somewhere safe: without it, stored integration secrets cannot be read.
APP_SECRET_KEY=change-me

# Signs session cookies. Generate with: openssl rand -base64 48
SESSION_SECRET=change-me

# fatal, error, warn, info, debug or trace
LOG_LEVEL=info
