# Copy to .env and replace every change-me value. scripts/install.sh fills these in for you.

# Image tag to run. Pin a released version; upgrade by changing it and running
# docker compose pull && docker compose up -d
OPEN_ITSM_VERSION=1.0.0

# Hostname users open in the browser. A public name gets a Let's Encrypt
# certificate automatically; for an internal-only name see CADDY_GLOBAL_OPTIONS or CADDY_TLS.
# A name only, no https:// or port. Links in notifications, SSO and portal emails use it too.
APP_HOSTNAME=itsm.example.com

# Extra Caddy global options. Set to local_certs to use Caddy's internal CA
# (for hostnames that are not reachable from the internet).
CADDY_GLOBAL_OPTIONS=

# Optional Caddy tls directive for your own certificate placed in ./certs:
#   CADDY_TLS=tls /certs/cert.pem /certs/key.pem
# Leave empty to use Let's Encrypt or Caddy's internal CA.
CADDY_TLS=

# Database password. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Encrypts stored credentials (AES-256-GCM). 32 random bytes as base64.
# Generate with: openssl rand -base64 32
# Keep a copy somewhere safe: without it, stored integration secrets cannot be read.
APP_SECRET_KEY=change-me

# Signs session cookies. Generate with: openssl rand -base64 48
SESSION_SECRET=change-me

# How many days of nightly backups to keep in the backups volume (default 14).
BACKUP_RETENTION_DAYS=14

# fatal, error, warn, info, debug or trace
LOG_LEVEL=info
